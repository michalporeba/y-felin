{
  "name": "@michalporeba/y-felin",
  "version": "0.1.1",
  "description": "A TUI bullet-journal / personal task manager keeping the data local with an option of syncing it to SOLID Pods.",
  "author": "Michał Poręba <michalporeba@gmail.com>",
  "repository": "github:michalporeba/y-felin",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fln": "./dist/src/fln.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "tui": "node --import tsx src/tui.tsx --data-dir=./data",
    "test": "vitest run"
  },
  "keywords": [
    "local-first",
    "rdf",
    "todo",
    "tui",
    "solid-pod"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "lofipod": "^0.3.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
